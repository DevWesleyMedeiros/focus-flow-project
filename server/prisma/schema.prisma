// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id                  String                @id @default(uuid())
  email               String                @unique
  displayName         String
  passwordHash        String? // null = conta Google, preenchido = conta local
  firebaseUid         String?               @unique // null = conta local, preenchido = conta Google
  dailyGoal           Int                   @default(8) // 8 pomodoros por dia
  avatar              Avatar?
  passwordTokenReset  PasswordTokenReset[]
  focusSessions       FocusSession[]
  tasks               Task[]
  categories          Category[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([createdAt])
}

model Avatar {
  id        String   @id @default(uuid())
  userId    String   @unique
  url       String
  mime      String
  size      Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordTokenReset {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model FocusSession {
  id          String    @id @default(uuid())
  userId      String
  taskId      String?
  duration    Int // duração em minutos
  startTime   DateTime
  endTime     DateTime?
  completed   Boolean   @default(false)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, startTime, completed])
}

model Task {
  id            String         @id @default(uuid())
  userId        String
  categoryId    String?
  title         String
  description   String?
  priority      Priority       @default(MEDIUM)
  completed     Boolean        @default(false)
  order         Int // para reordenação de tarefas
  dueDate       DateTime?
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  focusSessions FocusSession[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId, order, completed])
  @@index([categoryId])
}

model Category {
  id        String   @id @default(uuid())
  name      String
  color     String // hex color
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}