# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/focusflow?schema=public"

# Firebase Admin Configuration
FIREBASE_SERVICE_ACCOUNT_KEY="{}"

# Server Configuration
PORT=8080
CLIENT_ORIGIN=http://localhost:3000
SESSION_CROSS_SITE=false

# Cloudinary Configuration (para upload de avatares)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email (Resend) - deixar em branco para desativar envio em dev
RESEND_API_KEY=
MAIL_FROM=noreply@your-domain.com
# Node Environment
NODE_ENV=development

# credenciais do firebase
FIREBASE_PROJECT_ID="SEU_PROJETO_ID"
FIREBASE_PRIVATE_KEY="SEUA_CHAVE_PRIVATE_FIREBASE"
FIREBASE_CLIENT_EMAIL="SEU_EMAIL_CLIENTE"

